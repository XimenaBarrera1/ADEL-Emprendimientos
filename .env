# API Configuration
# Paste your Gemini API key below
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
# The local port where your server will run
PORT=3000

# Database Configuration
# Connection details for your local MySQL/MariaDB database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=adel
